# videoCRM 자격증명. 이 파일을 .env 로 복사해서 값을 채운다.
# .env 는 커밋되지 않는다. 값은 화면(/settings)에서 넣어도 되고, 넣으면 그쪽이 이긴다.

# ── 성과 수집 (조회수·좋아요·댓글) ─────────────────────────────
# 이것만 있으면 공개 영상 통계 수집이 돈다. OAuth 는 필요 없다.
#
#   1. https://console.cloud.google.com 에서 프로젝트 만들기
#   2. API 및 서비스 → 라이브러리 → YouTube Data API v3 → 사용 설정
#   3. 사용자 인증 정보 → 만들기 → API 키
#   4. (권장) 키 제한 → API 제한 → YouTube Data API v3 만 선택
GOOGLE_API_KEY=

# ── 유튜브 업로드 ───────────────────────────────────────────────
# 업로드·자막·섬네일에 필요하다. 위와 같은 GCP 프로젝트에서 만든다.
#
#   사용자 인증 정보 → 만들기 → OAuth 클라이언트 ID → 애플리케이션 유형: 웹 애플리케이션
#   승인된 리디렉션 URI: http://localhost:4300/oauth/google/callback
#   OAuth 동의 화면 → 테스트 사용자에 본인 계정 등록 (심사 없이 쓸 수 있다)
#
#   주의: 동의 화면이 "테스트" 상태면 refresh token 이 7일 뒤 만료된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 나레이션 ────────────────────────────────────────────────────
# 키가 필요 없다. 에이전트가 힉스필드 MCP 로 음성을 만들고
# save_narration(project_id, audio_path) 로 파일만 넘겨준다.
# 무음 정렬·장면 타이밍·자막 생성은 videoCRM 이 한다.